# Plantilla de variables de entorno. Copia a .env.local y completa los valores.
# NUNCA subas valores reales a Git: en producción se configuran en Vercel
# (Settings > Environment Variables).

# Formularios - envío de correo con Resend (solo servidor, api/formulario.js)
RESEND_API_KEY=
# Destinatarios de los formularios (varios separados por coma)
FORMS_TO_EMAIL=
# Remitente verificado en Resend, ej. Formularios <formularios@tu-dominio.com>
FORMS_FROM_EMAIL=

# CMS - login con GitHub (api/auth.js)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 - subida de imágenes del CMS (api/upload.js)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# URL pública del bucket (opcional; si falta se usa R2_ENDPOINT/R2_BUCKET)
R2_PUBLIC_URL=
