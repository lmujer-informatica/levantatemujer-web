  "identidad": {
    "historia": {
      "titulo": "Nuestra Historia",
      "texto": "La Fundación Levántate Mujer nació con el propósito de transformar la vida de las mujeres bolivianas a través de programas integrales de capacitación, atención y acompañamiento. Desde nuestros inicios, hemos trabajado incansablemente para construir espacios seguros donde cada mujer pueda desarrollar su máximo potencial, enfrentar las adversidades y construir un futuro digno y lleno de oportunidades para ella y sus comunidades."
    },
    "mision": {
      "titulo": "Misión",
      "texto": "Brindar atención integral a mujeres víctimas de violencia, trata y tráfico de personas, a través de programas de prevención, acompañamiento psicológico, asesoría legal y capacitación que fortalezcan su autonomía y bienestar."
    },
    "vision": {
      "titulo": "Visión",
      "texto": "Ser una fundación líder en la promoción de los derechos de las mujeres en Bolivia, reconocida por su impacto transformador en la construcción de una sociedad más justa, igualitaria y libre de violencia."
    }
  },
