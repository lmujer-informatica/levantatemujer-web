  "identidad": {
    "historia": {
      "titulo": "Nuestra Historia",
      "texto": "La Fundación Levántate Mujer nació con el propósito de transformar la vida de las mujeres bolivianas a través de programas integrales de capacitación, atención y acompañamiento. Desde nuestros inicios, hemos trabajado incansablemente para construir espacios seguros donde cada mujer pueda desarrollar su máximo potencial, enfrentar las adversidades y construir un futuro digno y lleno de oportunidades para ella y sus comunidades a lo largo de Bolivia."
    },
    "mision": {
      "titulo": "Misión",
      "texto": "Brindar atención integral a mujeres víctimas de violencia, trata y tráfico de personas, a través de programas de prevención, acompañamiento psicológico, asesoría legal y capacitación que fortalezcan su autonomía y bienestar."
    },
    "vision": {
      "titulo": "Visión",
      "texto": "Ser una fundación líder en la promoción de los derechos de las mujeres en Bolivia, reconocida por su impacto transformador en la construcción de una sociedad más justa, igualitaria y libre de violencia."
    }
  },
  "valores": [
    {
      "nombre": "Acogida",
      "descripcion": "Creamos espacios seguros y cálidos donde cada mujer y su familia son recibidas con respeto, escucha activa y contención sin juzgar.",
      "imagen": "/uploads/imagenes/noticia-solidaridad-agosto.jpeg"
    },
    {
      "nombre": "Misericordia",
      "descripcion": "Inspiradas en el carisma del Buen Pastor, actuamos con profunda empatía y compromiso humano ante el dolor y las vivencias de cada persona.",
      "imagen": "/uploads/imagenes/noticia-defensoria-sucre.jpeg"
    },
    {
      "nombre": "Justicia",
      "descripcion": "Promovemos la restitución irrestricta de derechos fundamentales, el patrocinio legal ético y la transformación de estructuras que perpetúan la violencia.",
      "imagen": "/uploads/imagenes/noticia-promotoras-chuquisaca.jpeg"
    }
  ],
